# Sepolia JSON-RPC endpoint (must be chainId 11155111). e.g. an Alchemy/Infura Sepolia URL.
SEPOLIA_RPC_URL=https://sepolia.example.com/your-key

# BIP-39 mnemonic for a TEST wallet only. Never use a mnemonic that holds real funds.
# Used both as the Kohaku plugin keystore seed and (via the standard path m/44'/60'/0'/0/0)
# as the public signer that sends shield/ragequit transactions.
MNEMONIC=test test test test test test test test test test test junk

# Password used to encrypt the local Kohaku storage files (AES-256-GCM). Pick any strong value;
# losing it only costs a resync, it does not lose funds.
STORAGE_PASSWORD=change-me

# Max block span per eth_getLogs call (default: 499). Lower this if eth_getLogs fails with a
# "block range"/"Invalid params" error — e.g. Alchemy's free tier only allows 10-block ranges,
# so set GETLOGS_MAX_SPAN=9 there (chunk width = GETLOGS_MAX_SPAN + 1 blocks).
# GETLOGS_MAX_SPAN=9

# Pause in ms between eth_getLogs chunk requests (default: 0). A low GETLOGS_MAX_SPAN means many
# more chunk requests for the same range, which can trip a free-tier RPC's requests/compute-units
# per second limit (HTTP 429 "exceeded its compute units per second capacity") even though each
# individual request is valid. Alchemy's free tier pairs well with GETLOGS_MAX_SPAN=9 and
# GETLOGS_DELAY_MS=200.
# GETLOGS_DELAY_MS=200

# --- optional: e2e fork tests (test/e2e) ---
# Archive RPC URL to fork Sepolia from with anvil (prool). Tests requiring this are skipped if unset.
# ANVIL_FORK_RPC_URL=
# ANVIL_FORK_BLOCK=

# Archive RPC URL to fork mainnet from, for the Privacy Pools paymaster e2e test. Skipped if unset.
# ANVIL_MAINNET_FORK_RPC_URL=
# ANVIL_MAINNET_FORK_BLOCK=
